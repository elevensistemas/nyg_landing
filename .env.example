APP_NAME="NYG Transporte"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_URL=https://nygtransporte.com.ar
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nyg_transporte
DB_USERNAME=nyg_transporte
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=nyg

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP: configurar con los datos reales que provea NYG (o el proveedor de correo elegido)
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@nygtransporte.com.ar"
MAIL_FROM_NAME="${APP_NAME}"

# Correo interno de NYG que recibe copia de cada consulta/cotización
MAIL_NOTIFY_ADDRESS="info@nygtransporte.com.ar"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WhatsApp: número en formato internacional sin signos (confirmar número real con NYG,
# el sitio actual muestra una inconsistencia entre el número visible y el del enlace tel:)
WHATSAPP_NUMBER=5491130091907

# Protección anti-spam del formulario (opcional). Dejar en null para desactivar.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
